{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup",
        "hooks": [
          {
            "type": "command",
            "command": "powershell.exe",
            "args": [
              "-NoProfile",
              "-ExecutionPolicy",
              "Bypass",
              "-File",
              "${CLAUDE_PROJECT_DIR}/scripts/Initialize-Worktree.ps1"
            ],
            "timeout": 120,
            "statusMessage": "Seeding worktree (config files + packages)..."
          }
        ]
      }
    ]
  }
}
